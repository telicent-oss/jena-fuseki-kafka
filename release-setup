# -*- mode: shell-script; -*-
# Source me

## ------------------------
## This will override the settings in POM

## Revert:
##    mvn versions:set -DnewVersion=???-SNAPSHOT

export VER=3.0.5
VER_NEXT=3.0.6-SNAPSHOT
TAG="v$VER"

## Set release and next version.
## If not set, mvn release:prepare will ask for them.
MVN_VER_ARGS=(
  "-DreleaseVersion=$VER"
  "-DdevelopmentVersion=$VER_NEXT"
  "-Dtag=$TAG"
)

## Code artifact 429s
MVN_EXTRA_ARGS=(
  "-Daether.connector.basic.parallelPut=false"
)

MVN_ARGS=("${MVN_VER_ARGS[@]}" "${MVN_EXTRA_ARGS[@]}")

release_mvn() {
  mvn "${MVN_ARGS[@]}" "$@"
}

## Extras:
## Different local repo for release build:
##REPO="-Dmaven.repo.local=..separate maven local repo ..
## If signing artifacts
##export KEY="-Darguments=-Dgpg.keyname=SIGNATURE"
##release_mvn -Dmaven.repo.local=... -Darguments=-Dgpg.keyname=SIGNATURE ...

echo "Release: $VER, next development: $VER_NEXT, tagged: $TAG"
printf 'MVN_ARGS=%s\n' "${MVN_ARGS[*]}"
echo "## Dry run release"
echo "  release_mvn -DdryRun=true release:clean release:prepare"
